{
  "name": "upload-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "npm run plugin:build && tauri dev",
    "desktop:build": "npm run plugin:build && tauri build --no-bundle && node tools/stage-plugins.mjs release",
    "desktop:build:debug": "npm run plugin:build && tauri build --debug --no-bundle && node tools/stage-plugins.mjs debug",
    "plugin:new": "node tools/new-plugin.mjs",
    "test:core": "cargo test -p upload-core",
    "check:rust": "cargo check --workspace",
    "test:ui": "node --test tests/ui.test.mjs",
    "plugin:build": "npm run plugin:build:pixiv && npm run plugin:build:x",
    "plugin:build:pixiv": "powershell -ExecutionPolicy Bypass -File plugins/pixiv/build-plugin.ps1",
    "test:pixiv": "cargo test --manifest-path plugins/pixiv/Cargo.toml && npm --prefix plugins/pixiv test",
    "plugin:build:x": "powershell -ExecutionPolicy Bypass -File plugins/x/build-plugin.ps1",
    "test:x": "npm --prefix plugins/x test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
